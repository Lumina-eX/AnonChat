# ─────────────────────────────────────────────────────────────────────────────
# AnonChat — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local — it is already in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (required) ───────────────────────────────────────────────────────
# Find these in your Supabase project: Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Stellar (required for blockchain features) ────────────────────────────────
# STELLAR_NETWORK: "testnet" or "mainnet"
STELLAR_NETWORK=testnet
# STELLAR_SOURCE_SECRET: secret key of the service wallet that signs transactions
# Create a funded testnet account at https://laboratory.stellar.org/#account-creator?network=test
STELLAR_SOURCE_SECRET=S...your-testnet-secret-key...
# Horizon API endpoint — use the testnet URL below for local development
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
# Transaction timeout in milliseconds (default: 30000)
STELLAR_TRANSACTION_TIMEOUT=30000

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_APP_NAME=AnonChat

# ── Redis (optional — rate limiting falls back to in-memory without this) ─────
# REDIS_URL=redis://localhost:6379
